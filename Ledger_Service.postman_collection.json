{
	"info": {
		"name": "Backend Ledger API",
		"description": "API collection for testing and demonstrating the Double-Entry Ledger Service. Implements dynamic environment variable saving for seamless authentication flow.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Register User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.token) {",
									"        pm.collectionVariables.set(\"token\", jsonData.token);",
									"        console.log(\"Saved JWT Token to variables!\");",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Alice Smith\",\n    \"email\": \"alice@example.com\",\n    \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "http://localhost:3000/api/auth/register",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "3000",
							"path": [
								"api",
								"auth",
								"register"
							]
						},
						"description": "Registers a new user profile and automatically saves the returned JWT token as a variable."
					},
					"response": []
				},
				{
					"name": "Login User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.token) {",
									"        pm.collectionVariables.set(\"token\", jsonData.token);",
									"        console.log(\"Saved JWT Token to variables!\");",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"alice@example.com\",\n    \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "http://localhost:3000/api/auth/login",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "3000",
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"description": "Authenticates an existing user and retrieves a new JWT Token."
					},
					"response": []
				},
				{
					"name": "Logout User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    pm.collectionVariables.unset(\"token\");",
									"    console.log(\"Cleared JWT Token variable!\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [],
						"url": {
							"raw": "http://localhost:3000/api/auth/logout",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "3000",
							"path": [
								"api",
								"auth",
								"logout"
							]
						},
						"description": "Logs out the user and blacklists the token."
					},
					"response": []
				}
			]
		},
		{
			"name": "Accounts",
			"item": [
				{
					"name": "Create Account",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.account && jsonData.account._id) {",
									"        // Save to accountId1 if not set, else accountId2",
									"        if (!pm.collectionVariables.get(\"accountId1\")) {",
									"            pm.collectionVariables.set(\"accountId1\", jsonData.account._id);",
									"            console.log(\"Saved accountId1:\", jsonData.account._id);",
									"        } else {",
									"            pm.collectionVariables.set(\"accountId2\", jsonData.account._id);",
									"            console.log(\"Saved accountId2:\", jsonData.account._id);",
									"        }",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "http://localhost:3000/api/accounts",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "3000",
							"path": [
								"api",
								"accounts"
							]
						},
						"description": "Creates a new ledger account for the authenticated user."
					},
					"response": []
				},
				{
					"name": "Get User Accounts",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "http://localhost:3000/api/accounts",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "3000",
							"path": [
								"api",
								"accounts"
							]
						},
						"description": "Lists all active ledger accounts owned by the authenticated user."
					},
					"response": []
				},
				{
					"name": "Get Account Balance",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "http://localhost:3000/api/accounts/balance/{{accountId1}}",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "3000",
							"path": [
								"api",
								"accounts",
								"balance",
								"{{accountId1}}"
							]
						},
						"description": "Retrieves the dynamically calculated balance of the specified account."
					},
					"response": []
				}
			]
		},
		{
			"name": "Transactions",
			"item": [
				{
					"name": "Transfer Funds",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"fromAccount\": \"{{accountId1}}\",\n    \"toAccount\": \"{{accountId2}}\",\n    \"amount\": 150,\n    \"idempotencyKey\": \"txn_{{$randomUUID}}\"\n}"
						},
						"url": {
							"raw": "http://localhost:3000/api/transactions",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "3000",
							"path": [
								"api",
								"transactions"
							]
						},
						"description": "Performs an atomic double-entry transfer between two accounts using Postman's random UUID generator for the idempotency key."
					},
					"response": []
				},
				{
					"name": "Deposit Initial Funds (System User)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"toAccount\": \"{{accountId1}}\",\n    \"amount\": 10000,\n    \"idempotencyKey\": \"sys_{{$randomUUID}}\"\n}"
						},
						"url": {
							"raw": "http://localhost:3000/api/transactions/system/initial-funds",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "3000",
							"path": [
								"api",
								"transactions",
								"system",
								"initial-funds"
							]
						},
						"description": "Deposits starting capital from the System account to your user account. Note: Your user document must have `systemUser: true` in MongoDB to authorize this action."
					},
					"response": []
				}
			]
		}
	],
	"variable": [
		{
			"key": "token",
			"value": "",
			"type": "string"
		},
		{
			"key": "accountId1",
			"value": "",
			"type": "string"
		},
		{
			"key": "accountId2",
			"value": "",
			"type": "string"
		}
	]
}
